# Chat providers (any of them). Keys typed in the settings take priority over this file.
# Ollama, LM Studio and vLLM need no key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
REPLICATE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
AZURE_API_KEY=

# Images (OpenAI images reuse OPENAI_API_KEY)
STABILITY_API_KEY=

# Voice: read aloud uses OPENAI_API_KEY or GOOGLE_API_KEY, voice input uses OPENAI_API_KEY

# Coding assistant
# GitHub token for private repos, code search and higher rate limits. On a public deployment every visitor can read
# the repos this token can see, so use a token limited to public repos there.
GITHUB_TOKEN=
# A local project folder the assistant can read, and edit when allowed in the settings. Only for running the app on
# your own machine; leave it empty on a public deployment.
CODE_WORKSPACE=
